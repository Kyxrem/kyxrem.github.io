# Copy this file to api-relay/.env and fill in your tokens.
# .env is git-ignored — tokens never leave your machine.

# Clash of Clans: https://developer.clashofclans.com -> My Account -> Create New Key
#   "Allowed IP addresses" = your static home IP
COC_TOKEN=

# Clash Royale: https://developer.clashroyale.com -> same steps, same IP
CR_TOKEN=

# Optional:
#PORT=8901
#ALLOW_ORIGIN=*                 # e.g. https://kyxrem.github.io to lock it down
#SERVE_SITE=1                   # also serve this repo as a website (0 = API only)
#CACHE_SECONDS=300
#USE_ROYALEAPI_PROXY=0          # 1 = route via RoyaleAPI proxy (then whitelist 45.79.218.79 instead)
